<Page
    x:Class="MailClient.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="24,24,24,24">
        <StackPanel Spacing="4" MaxWidth="800" HorizontalAlignment="Left">

            <TextBlock
                Text="Einstellungen"
                FontSize="28"
                FontWeight="SemiBold"
                Margin="0,0,0,24" />

            <!-- ACCOUNTS ────────────────────────────────────────────── -->
            <TextBlock
                Text="E-Mail-Accounts"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,0,0,8" />

            <!-- Account-Liste -->
            <ListView
                x:Name="AccountListView"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,4"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Border
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="{StaticResource MailAccentBrush}">
                                <FontIcon
                                    Glyph="&#xE715;"
                                    FontSize="18"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding EmailAddress}"
                                    FontSize="12"
                                    Foreground="{ThemeResource
                                        TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Bearbeiten -->
                            <Button
                                Grid.Column="2"
                                ToolTipService.ToolTip="Bearbeiten"
                                VerticalAlignment="Center"
                                Tag="{Binding}"
                                Click="EditAccount_Click">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>

                            <!-- Löschen -->
                            <Button
                                Grid.Column="3"
                                ToolTipService.ToolTip="Account entfernen"
                                VerticalAlignment="Center"
                                Tag="{Binding}"
                                Click="DeleteAccount_Click">
                                <FontIcon
                                    Glyph="&#xE74D;"
                                    FontSize="14"
                                    Foreground="{ThemeResource
                                        SystemFillColorCriticalBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Account hinzufügen -->
            <Button
                HorizontalAlignment="Stretch"
                Height="48"
                Padding="12,0"
                Margin="0,4,0,0"
                Click="AddAccount_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE710;" VerticalAlignment="Center" />
                    <TextBlock Text="Account hinzufügen" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- DARSTELLUNG ─────────────────────────────────────────── -->
            <TextBlock
                Text="Darstellung"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,32,0,8" />

            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Height="52" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Design"
                            VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <RadioButtons
                    x:Name="ThemeRadio"
                    SelectionChanged="Theme_Changed">
                    <RadioButton Content="System" Tag="System" />
                    <RadioButton Content="Hell" Tag="Light" />
                    <RadioButton Content="Dunkel" Tag="Dark" />
                </RadioButtons>
            </Expander>

            <!-- ÜBER ──────────────────────────────────────────────────── -->
            <TextBlock
                Text="Über"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,32,0,8" />

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mail Client v1.0 — IMAP/SMTP via MailKit · WinUI 3" />

        </StackPanel>
    </ScrollViewer>
</Page>
