<Page
    x:Class="MailClient.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    Background="Transparent">

    <Page.Resources>
        <helpers:DateTimeConverter x:Key="DateConv" />
        <helpers:UnreadToBoldConverter x:Key="BoldConv" />
        <helpers:InitialsConverter x:Key="InitialsConv" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisConv" />
        <helpers:BoolToVisibilityConverter x:Key="InvertVisConv" Invert="True" />
    </Page.Resources>

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left"
        OpenPaneLength="240"
        IsSettingsVisible="True"
        SelectionChanged="NavView_SelectionChanged">

        <!-- Pane Header: Account + Verfassen -->
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,8,12,4" Spacing="8">
                <ComboBox
                    x:Name="AccountCombo"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Account wählen..."
                    SelectionChanged="AccountCombo_SelectionChanged" />
                <Button
                    Content="✏️  Verfassen"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="8"
                    Click="Compose_Click" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <!-- Ordner -->
        <NavigationView.MenuItems>
            <NavigationViewItem Tag="INBOX">
                <NavigationViewItem.Content>
                    <TextBlock Text="Posteingang" />
                </NavigationViewItem.Content>
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE715;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="InboxBadge"
                               Value="0"
                               Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem Tag="SENT" Content="Gesendet">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE724;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="DRAFTS" Content="Entwürfe">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem Tag="TRASH" Content="Papierkorb">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="SPAM" Content="Spam">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA8F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Hauptbereich -->
        <Grid x:Name="ContentRoot">

            <!-- 3-Spalten Mail-Ansicht -->
            <Grid x:Name="MailView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260" MaxWidth="480" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── Spalte 0: Mailliste ── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Suche -->
                    <AutoSuggestBox
                        Grid.Row="0"
                        Margin="12,10,12,4"
                        PlaceholderText="Suchen..."
                        QueryIcon="Find"
                        TextChanged="Search_TextChanged" />

                    <!-- Fehleranzeige -->
                    <InfoBar
                        x:Name="MailInfoBar"
                        Grid.Row="1"
                        Margin="8,0"
                        IsOpen="False"
                        IsClosable="True" />

                    <!-- Liste + Zustände -->
                    <Grid Grid.Row="2">

                        <!-- Laden -->
                        <StackPanel
                            x:Name="LoadingPanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="36" Height="36" />
                            <TextBlock
                                Text="E-Mails werden geladen..."
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Leer -->
                        <StackPanel
                            x:Name="EmptyPanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Visibility="Collapsed">
                            <FontIcon
                                Glyph="&#xE715;"
                                FontSize="48"
                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Keine E-Mails"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Kein Account -->
                        <StackPanel
                            x:Name="NoAccountPanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Visibility="Visible">
                            <FontIcon
                                Glyph="&#xE77B;"
                                FontSize="48"
                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Kein Account konfiguriert"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="Einstellungen → Account hinzufügen"
                                FontSize="12"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                        </StackPanel>

                        <!-- Mailliste -->
                        <ListView
                            x:Name="MailListView"
                            SelectionMode="Single"
                            SelectionChanged="MailList_SelectionChanged"
                            Padding="0,4"
                            Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="12,10"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <Border
                                                Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="{StaticResource MailAccentBrush}">
                                                <TextBlock
                                                    Text="{Binding FromDisplay,
                                                        Converter={StaticResource InitialsConv}}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Absender + Betreff + Vorschau -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Text="{Binding FromDisplay}"
                                                    FontWeight="{Binding IsRead,
                                                        Converter={StaticResource BoldConv}}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding Subject}"
                                                    FontSize="12"
                                                    FontWeight="{Binding IsRead,
                                                        Converter={StaticResource BoldConv}}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{Binding Preview}"
                                                    FontSize="11"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{ThemeResource
                                                        TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Datum + Anhang -->
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Top"
                                                Spacing="4"
                                                Margin="0,2,0,0">
                                                <TextBlock
                                                    Text="{Binding Date,
                                                        Converter={StaticResource DateConv}}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource
                                                        TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Right" />
                                                <FontIcon
                                                    Glyph="&#xE723;"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource
                                                        TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Right"
                                                    Visibility="{Binding HasAttachments,
                                                        Converter={StaticResource BoolToVisConv}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Trennlinie -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- ── Spalte 2: Mail-Detail ── -->
                <Grid Grid.Column="2"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">

                    <!-- Kein Mail gewählt -->
                    <StackPanel
                        x:Name="NoMailSelected"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <FontIcon
                            Glyph="&#xE715;"
                            FontSize="64"
                            Foreground="{ThemeResource TextFillColorDisabledBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="E-Mail auswählen"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Detail-Panel -->
                    <Grid x:Name="MailDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel
                            Grid.Row="0"
                            Padding="24,16"
                            Spacing="10"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource
                                DividerStrokeColorDefaultBrush}">

                            <!-- Betreff -->
                            <TextBlock
                                x:Name="DetailSubject"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <!-- Von / Datum -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        x:Name="DetailFrom"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="DetailTo"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource
                                            TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="DetailDate"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Foreground="{ThemeResource
                                        TextFillColorSecondaryBrush}" />
                            </Grid>

                            <!-- Aktionen -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="Reply_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE97A;" FontSize="14" />
                                        <TextBlock Text="Antworten" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Forward_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE89B;" FontSize="14" />
                                        <TextBlock Text="Weiterleiten" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Delete_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="Löschen" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Lade-Overlay für Body -->
                        <Grid Grid.Row="1"
                              Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <ProgressRing
                                x:Name="BodyLoadingRing"
                                IsActive="False"
                                Width="36" Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <WebView2
                                x:Name="MailWebView"
                                NavigationCompleted="MailWebView_NavigationCompleted" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Einstellungen (überblendet) -->
            <Frame x:Name="SettingsFrame" Visibility="Collapsed" />

        </Grid>
    </NavigationView>
</Page>
