<ContentDialog
    x:Class="MailClient.App.Views.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Account konfigurieren"
    PrimaryButtonText="Speichern"
    SecondaryButtonText="Verbindung testen"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click"
    SecondaryButtonClick="Test_Click"
    MinWidth="700"
    MaxWidth="900">

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="0,4">

            <!-- Allgemein -->
            <TextBlock
                Text="Allgemein"
                FontWeight="SemiBold"
                FontSize="14" />

            <TextBox
                x:Name="DisplayNameBox"
                Header="Anzeigename"
                PlaceholderText="z.B. Max Mustermann" />

            <TextBox
                x:Name="EmailBox"
                Header="E-Mail-Adresse"
                PlaceholderText="name@example.com"
                InputScope="EmailSmtpAddress"
                TextChanged="EmailBox_TextChanged" />

            <TextBox
                x:Name="UsernameBox"
                Header="Benutzername (oft identisch mit E-Mail)"
                PlaceholderText="name@example.com" />

            <PasswordBox
                x:Name="PasswordBox"
                Header="Passwort"
                PlaceholderText="••••••••" />

            <!-- IMAP -->
            <TextBlock
                Text="Eingehende Post (IMAP)"
                FontWeight="SemiBold"
                FontSize="14"
                Margin="0,8,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ImapHostBox"
                    Header="IMAP-Server"
                    PlaceholderText="imap.example.com" />
                <TextBox
                    x:Name="ImapPortBox"
                    Grid.Column="1"
                    Header="Port"
                    PlaceholderText="993"
                    Text="993" />
            </Grid>

            <ToggleSwitch
                x:Name="ImapSslToggle"
                Header="SSL/TLS verwenden"
                IsOn="True" />

            <!-- SMTP -->
            <TextBlock
                Text="Ausgehende Post (SMTP)"
                FontWeight="SemiBold"
                FontSize="14"
                Margin="0,8,0,0" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SmtpHostBox"
                    Header="SMTP-Server"
                    PlaceholderText="smtp.example.com" />
                <TextBox
                    x:Name="SmtpPortBox"
                    Grid.Column="1"
                    Header="Port"
                    PlaceholderText="587"
                    Text="587" />
            </Grid>

            <ToggleSwitch
                x:Name="SmtpSslToggle"
                Header="SSL/TLS / STARTTLS verwenden"
                IsOn="True" />

            <!-- Status -->
            <InfoBar
                x:Name="DialogInfoBar"
                IsOpen="False"
                IsClosable="False" />

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
