<ContentDialog x:ConnectionId='1'
    x:Class="MailClient.App.Views.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
                                   
    PrimaryButtonText="Speichern"
                                     
    SecondaryButtonText="Verbindung testen"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Border
                Width="40"
                Height="40"
                Background="{StaticResource BrandGradientBrush}"
                CornerRadius="12">
                <FontIcon
                    FontSize="18"
                    Foreground="White"
                    Glyph="&#xE715;" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:ConnectionId='2'
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Konto hinzufügen" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Serverdaten werden für bekannte Anbieter automatisch ausgefüllt" />
            </StackPanel>
        </StackPanel>
    </ContentDialog.Title>

    <ScrollViewer Width="620" Padding="0,0,16,0">
        <StackPanel Padding="0,4,0,8" Spacing="14">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:ConnectionId='16'
                    x:Name="DisplayNameBox"
                    Header="Anzeigename"
                    PlaceholderText="Max Mustermann" />
                <TextBox x:ConnectionId='17'
                    x:Name="EmailBox"
                    Grid.Column="1"
                    Header="E-Mail-Adresse *"
                    InputScope="EmailSmtpAddress"
                    PlaceholderText="name@example.com"
                                                       />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:ConnectionId='14'
                    x:Name="UsernameBox"
                    Header="Benutzername"
                    PlaceholderText="leer = E-Mail-Adresse" />
                <PasswordBox x:ConnectionId='15'
                    x:Name="PasswordBox"
                    Grid.Column="1"
                    Header="Passwort *"
                    PasswordRevealMode="Peek"
                    PlaceholderText="••••••••" />
            </Grid>

            <InfoBar x:ConnectionId='3'
                x:Name="ProviderHint"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational" />

            <Expander x:ConnectionId='4'
                x:Name="ServerExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Padding="0,10" Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE968;" />
                        <StackPanel>
                            <TextBlock Text="Servereinstellungen" />
                            <TextBlock x:ConnectionId='7'
                                x:Name="ServerSummary"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="IMAP &amp; SMTP" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>

                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Posteingang (IMAP)" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:ConnectionId='11'
                            x:Name="ImapHostBox"
                            Header="Server *"
                            PlaceholderText="imap.example.com" />
                        <NumberBox x:ConnectionId='12'
                            x:Name="ImapPortBox"
                            Grid.Column="1"
                            Header="Port"
                            Maximum="65535"
                            Minimum="1"
                            Value="993" />
                        <ToggleSwitch x:ConnectionId='13'
                            x:Name="ImapSslToggle"
                            Grid.Column="2"
                            Header="SSL/TLS"
                            IsOn="True"
                            OffContent="Aus"
                            OnContent="An"
                                                      />
                    </Grid>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontWeight="SemiBold"
                        Text="Postausgang (SMTP)" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:ConnectionId='8'
                            x:Name="SmtpHostBox"
                            Header="Server *"
                            PlaceholderText="smtp.example.com" />
                        <NumberBox x:ConnectionId='9'
                            x:Name="SmtpPortBox"
                            Grid.Column="1"
                            Header="Port"
                            Maximum="65535"
                            Minimum="1"
                            Value="587" />
                        <ToggleSwitch x:ConnectionId='10'
                            x:Name="SmtpSslToggle"
                            Grid.Column="2"
                            Header="SSL/STARTTLS"
                            IsOn="True"
                            OffContent="Aus"
                            OnContent="An" />
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Port 993/465 = SSL direkt, 143/587 = STARTTLS. Die richtige Methode wird automatisch gewählt."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <TextBox x:ConnectionId='5'
                x:Name="SignatureBox"
                MinHeight="80"
                AcceptsReturn="True"
                Header="Signatur (optional)"
                PlaceholderText="Viele Grüße&#x0a;Max Mustermann"
                TextWrapping="Wrap" />

            <InfoBar x:ConnectionId='6'
                x:Name="DialogInfoBar"
                IsClosable="False"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

