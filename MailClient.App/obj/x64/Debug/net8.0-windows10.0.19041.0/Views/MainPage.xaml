<Page
    x:Class="MailClient.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    xmlns:models="using:MailClient.Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:MailClient.App.Views"
    Background="Transparent"
    FontFamily="{StaticResource AppFont}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator x:ConnectionId='2' Key="N"                         Modifiers="Control" />
        <KeyboardAccelerator x:ConnectionId='3' Key="F5"                      />
        <KeyboardAccelerator x:ConnectionId='4' Key="R"                       Modifiers="Control" />
        <KeyboardAccelerator x:ConnectionId='5' Key="R"                          Modifiers="Control,Shift" />
        <KeyboardAccelerator x:ConnectionId='6' Key="L"                         Modifiers="Control" />
        <KeyboardAccelerator x:ConnectionId='7' Key="Q"                            Modifiers="Control" />
        <KeyboardAccelerator x:ConnectionId='8' Key="E"                        Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid x:ConnectionId='9' x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ════════════════ SIDEBAR ════════════════  -->
        <Grid x:ConnectionId='10'
            x:Name="Sidebar"
            Width="260"
            Padding="16,4,16,16"
            RowSpacing="{StaticResource SpaceMd}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:ConnectionId='98'
                x:Name="ComposeButton"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="14,0"
                helpers:Motion.HoverLift="True"
                                     
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTipService.ToolTip="Neue E-Mail (Strg+N)">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                    <ImageIcon helpers:Svg.Kind="compose" helpers:Svg.Tone="OnAccent" />
                    <TextBlock x:ConnectionId='118'
                        x:Name="ComposeLabel"
                        VerticalAlignment="Center"
                        Text="Neue E-Mail" />
                </StackPanel>
            </Button>

            <ListView x:ConnectionId='99'
                x:Name="FolderList"
                Grid.Row="1"
                Margin="-8,8,-8,0"
                IsItemClickEnabled="True"
                                                
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate                                >
                        <Grid x:ConnectionId='112'
                            Height="38"
                            ColumnSpacing="{StaticResource SpaceLg}"
                                                                       >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ImageIcon x:ConnectionId='113'
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                                                
                                helpers:Svg.Tone="Secondary" />
                            <Ellipse x:ConnectionId='114'
                                Width="7"
                                Height="7"
                                Margin="0,6,-4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource AccentBrush}"
                                                                                 />
                            <TextBlock x:ConnectionId='115'
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeBase}"
                                                    
                                TextTrimming="CharacterEllipsis"
                                                                                   />
                            <Border x:ConnectionId='116'
                                Grid.Column="2"
                                MinWidth="22"
                                Padding="7,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="{StaticResource RadiusPill}"
                                                                                 >
                                <TextBlock x:ConnectionId='117'
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXs}"
                                    FontWeight="SemiBold"
                                                                           />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Account switcher  -->
            <Button x:ConnectionId='100'
                x:Name="AccountButton"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="6"
                Style="{StaticResource GhostButtonStyle}">
                <Grid ColumnSpacing="{StaticResource SpaceMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:ConnectionId='104'
                        x:Name="AccountAvatar"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Style="{StaticResource AvatarStyle}">
                        <TextBlock x:ConnectionId='109'
                            x:Name="AccountInitials"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeSm}"
                            FontWeight="SemiBold"
                            Text="+" />
                    </Border>
                    <StackPanel x:ConnectionId='105'
                        x:Name="AccountTextPanel"
                        Grid.Column="1"
                        VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='107'
                            x:Name="AccountNameText"
                            FontSize="{StaticResource FontSizeMd}"
                            FontWeight="SemiBold"
                            Text="Kein Konto"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock x:ConnectionId='108'
                            x:Name="AccountMailText"
                            FontSize="{StaticResource FontSizeXs}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Konto hinzufügen"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ImageIcon x:ConnectionId='106'
                        x:Name="AccountChevron"
                        Grid.Column="2"
                        Width="12"
                        Height="12"
                        helpers:Svg.Kind="chevron-up"
                        helpers:Svg.Tone="Secondary" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:ConnectionId='110' x:Name="AccountMenu" Placement="TopEdgeAlignedLeft" />
                </Button.Flyout>
            </Button>

            <Button x:ConnectionId='101'
                x:Name="SettingsButton"
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="12,9"
                                      
                Style="{StaticResource GhostButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceLg}">
                    <ImageIcon x:ConnectionId='102'
                        x:Name="SettingsIcon"
                        Width="18"
                        Height="18"
                        helpers:Svg.Kind="settings"
                        helpers:Svg.Tone="Secondary" />
                    <TextBlock x:ConnectionId='103' x:Name="SettingsLabel" Text="Einstellungen" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  ════════════════ CONTENT LAYER (glass panel) ════════════════  -->
        <Grid x:ConnectionId='11'
            x:Name="ContentLayer"
            Grid.Column="1"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="{StaticResource RadiusLayer}">

            <Grid x:ConnectionId='19' x:Name="MailArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ── Message list ──  -->
                <Grid x:ConnectionId='22'
                    x:Name="ListColumn"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="24,22,14,4">
                        <StackPanel x:ConnectionId='93' x:Name="FolderHeader">
                            <TextBlock x:ConnectionId='96'
                                x:Name="FolderTitle"
                                FontSize="{StaticResource FontSize2Xl}"
                                FontWeight="SemiBold"
                                Text="Posteingang"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock x:ConnectionId='97'
                                x:Name="FolderSubtitle"
                                Margin="0,4,0,0"
                                FontSize="{StaticResource FontSizeSm}"
                                Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            helpers:Motion.HoverLift="True"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Weitere Aktionen">
                            <ImageIcon helpers:Svg.Kind="more" helpers:Svg.Tone="Secondary" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:ConnectionId='94'                           Text="Alle als gelesen markieren">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon helpers:Svg.Kind="mail-open" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:ConnectionId='95'                      Text="Ordner neu laden">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon helpers:Svg.Kind="refresh" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <toolkit:Segmented x:ConnectionId='60'
                        x:Name="FilterSegmented"
                        Grid.Row="1"
                        Margin="20,12,20,12"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                                                                  >
                        <toolkit:SegmentedItem Content="Alle" />
                        <toolkit:SegmentedItem Content="Ungelesen" />
                        <toolkit:SegmentedItem Content="Markiert" />
                    </toolkit:Segmented>

                    <InfoBar x:ConnectionId='61'
                        x:Name="MailInfoBar"
                        Grid.Row="2"
                        Margin="16,0,16,8"
                        CornerRadius="{StaticResource RadiusMd}"
                        IsClosable="True"
                        IsOpen="False" />

                    <Grid Grid.Row="3">
                        <!--  Skeleton + shimmer  -->
                        <Grid x:ConnectionId='62'
                            x:Name="SkeletonHost"
                            IsHitTestVisible="False"
                                                                  
                            Visibility="Collapsed">
                            <ItemsControl x:ConnectionId='90' x:Name="SkeletonList" Padding="16,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="{StaticResource PadListItem}" ColumnSpacing="{StaticResource SpaceMd}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Top"
                                                Fill="{StaticResource SkeletonBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="9">
                                                <Rectangle
                                                    Width="140"
                                                    Height="11"
                                                    HorizontalAlignment="Left"
                                                    Fill="{StaticResource SkeletonBrush}"
                                                    RadiusX="5"
                                                    RadiusY="5" />
                                                <Rectangle
                                                    Height="9"
                                                    Margin="0,0,40,0"
                                                    Fill="{StaticResource SkeletonBrush}"
                                                    RadiusX="4"
                                                    RadiusY="4" />
                                                <Rectangle
                                                    Height="9"
                                                    Margin="0,0,90,0"
                                                    Fill="{StaticResource SkeletonBrush}"
                                                    RadiusX="4"
                                                    RadiusY="4" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle x:ConnectionId='91'
                                x:Name="ShimmerBar"
                                Width="220"
                                HorizontalAlignment="Left"
                                Fill="{StaticResource ShimmerBrush}" />
                        </Grid>

                        <!--  Empty state  -->
                        <StackPanel x:ConnectionId='63'
                            x:Name="EmptyPanel"
                            Padding="{StaticResource PadXl}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource SpaceSm}"
                            Visibility="Collapsed">
                            <Border
                                Width="72"
                                Height="72"
                                Margin="0,0,0,12"
                                CornerRadius="36"
                                Style="{StaticResource PanelStyle}">
                                <ImageIcon x:ConnectionId='89'
                                    x:Name="EmptyIcon"
                                    Width="28"
                                    Height="28"
                                    helpers:Svg.Kind="check"
                                    helpers:Svg.Tone="Secondary" />
                            </Border>
                            <TextBlock x:ConnectionId='87'
                                x:Name="EmptyTitle"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeLg}"
                                FontWeight="SemiBold"
                                Text="Alles erledigt" />
                            <TextBlock x:ConnectionId='88'
                                x:Name="EmptySubtitle"
                                MaxWidth="260"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  No account  -->
                        <StackPanel x:ConnectionId='64'
                            x:Name="NoAccountPanel"
                            Padding="{StaticResource PadXl}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource SpaceSm}"
                            Visibility="Collapsed">
                            <Border
                                Width="84"
                                Height="84"
                                Margin="0,0,0,16"
                                CornerRadius="42"
                                Style="{StaticResource PanelStyle}">
                                <ImageIcon
                                    Width="32"
                                    Height="32"
                                    helpers:Svg.Kind="mail" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeXl}"
                                FontWeight="SemiBold"
                                Text="Willkommen bei Mail" />
                            <TextBlock
                                MaxWidth="280"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Füge dein erstes E-Mail-Konto hinzu, um loszulegen."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button x:ConnectionId='86'
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                helpers:Motion.HoverLift="True"
                                                        
                                Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                    <ImageIcon helpers:Svg.Kind="plus" helpers:Svg.Tone="OnAccent" />
                                    <TextBlock Text="Konto hinzufügen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  Mail list  -->
                        <ListView x:ConnectionId='65'
                            x:Name="MailList"
                            Padding="0,0,0,16"
                                                                                        
                            IsItemClickEnabled="False"
                                                      
                                                                        
                            SelectionMode="Single">
                            <ListView.Resources>
                                <!--  Hover is drawn by the item itself (lift + glow)  -->
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="10,2" />
                                    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate                                >
                                    <Grid x:ConnectionId='67'
                                        Padding="{StaticResource PadListItem}"
                                        helpers:Motion.HoverLift="True"
                                        Background="Transparent"
                                        ColumnSpacing="{StaticResource SpaceMd}"
                                                                                
                                                                              >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Hover glow (no blur on list items)  -->
                                        <Border
                                            x:Name="HoverGlow"
                                            Grid.ColumnSpan="2"
                                            Margin="-12,-12,-14,-12"
                                            Background="{StaticResource PanelHoverBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="{StaticResource BorderHairline}"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Opacity="0" />

                                        <Grid
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Top">
                                            <Border CornerRadius="19" Style="{StaticResource AvatarStyle}">
                                                <TextBlock x:ConnectionId='82'
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeMd}"
                                                    FontWeight="SemiBold"
                                                                                                      />
                                            </Border>
                                            <Ellipse x:ConnectionId='81'
                                                Width="11"
                                                Height="11"
                                                Margin="0,-2,-3,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Fill="{StaticResource AccentBrush}"
                                                Stroke="{StaticResource OnAccentBrush}"
                                                StrokeThickness="2"
                                                                                                              />
                                        </Grid>

                                        <StackPanel x:ConnectionId='69'
                                            Grid.Column="1"
                                                                                                           
                                            Spacing="3">
                                            <Grid ColumnSpacing="{StaticResource SpaceSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='79'
                                                    FontSize="{StaticResource FontSizeBase}"
                                                                                                                 
                                                                               
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:ConnectionId='80'
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeXs}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                                               />
                                            </Grid>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='76'
                                                    FontSize="{StaticResource FontSizeMd}"
                                                                                                                 
                                                                           
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <ImageIcon x:ConnectionId='77'
                                                        Width="12"
                                                        Height="12"
                                                        helpers:Svg.Kind="paperclip"
                                                        helpers:Svg.Tone="Secondary"
                                                                                                              />
                                                    <ImageIcon x:ConnectionId='78'
                                                        Width="12"
                                                        Height="12"
                                                        helpers:Svg.Kind="flag"
                                                                                                                      />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:ConnectionId='75'
                                                FontSize="{StaticResource FontSizeSm}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                MaxLines="2"
                                                                       
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!--  Hover quick actions  -->
                                        <StackPanel x:ConnectionId='70'
                                            x:Name="HoverActions"
                                            Grid.Column="1"
                                            Margin="0,-6,-6,0"
                                            Padding="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource ToastBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="{StaticResource BorderHairline}"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            IsHitTestVisible="False"
                                                                        
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <Button x:ConnectionId='71'
                                                                       
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                              
                                                                                                                            >
                                                <ImageIcon x:ConnectionId='74'
                                                    Width="14"
                                                    Height="14"
                                                                                                                          />
                                            </Button>
                                            <Button x:ConnectionId='72'
                                                                       
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                              
                                                                                                                               >
                                                <ImageIcon
                                                    Width="14"
                                                    Height="14"
                                                    helpers:Svg.Kind="flag" />
                                            </Button>
                                            <Button x:ConnectionId='73'
                                                                         
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                              
                                                ToolTipService.ToolTip="Löschen">
                                                <ImageIcon
                                                    Width="14"
                                                    Height="14"
                                                    helpers:Svg.Kind="trash"
                                                    helpers:Svg.Tone="Danger" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <Grid x:ConnectionId='83'
                                    x:Name="LoadMorePanel"
                                    Padding="16,12"
                                    Visibility="Collapsed">
                                    <Button x:ConnectionId='84'
                                        x:Name="LoadMoreButton"
                                        HorizontalAlignment="Center"
                                        helpers:Motion.HoverLift="True"
                                                              
                                        Style="{StaticResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                            <ImageIcon
                                                Width="14"
                                                Height="14"
                                                helpers:Svg.Kind="arrow-down"
                                                helpers:Svg.Tone="Secondary" />
                                            <TextBlock Text="Ältere E-Mails laden" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressRing x:ConnectionId='85'
                                        x:Name="LoadMoreRing"
                                        Width="22"
                                        Height="22"
                                        IsActive="False" />
                                </Grid>
                            </ListView.Footer>
                        </ListView>
                    </Grid>
                </Grid>

                <!--  ── Reader ──  -->
                <Grid x:ConnectionId='23' x:Name="ReaderColumn" Grid.Column="1">

                    <StackPanel x:ConnectionId='24'
                        x:Name="ReaderEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceSm}">
                        <Border
                            Width="96"
                            Height="96"
                            Margin="0,0,0,16"
                            CornerRadius="48"
                            Style="{StaticResource PanelStyle}">
                            <ImageIcon
                                Width="34"
                                Height="34"
                                helpers:Svg.Kind="mail-open"
                                helpers:Svg.Tone="Secondary" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeXl}"
                            FontWeight="SemiBold"
                            Text="Keine E-Mail ausgewählt" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Wähle links eine Nachricht aus, um sie hier zu lesen." />
                    </StackPanel>

                    <Grid x:ConnectionId='25' x:Name="ReaderContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar  -->
                        <Grid Padding="20,12,20,4">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                <Button x:ConnectionId='56'
                                    helpers:Motion.HoverLift="True"
                                                       
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTipService.ToolTip="Antworten (Strg+R)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="reply" />
                                        <TextBlock Text="Antworten" />
                                    </StackPanel>
                                </Button>
                                <Button x:ConnectionId='57'
                                    helpers:Motion.HoverLift="True"
                                                          
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTipService.ToolTip="Allen antworten (Strg+Umschalt+R)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="reply-all" />
                                        <TextBlock Text="Allen antworten" />
                                    </StackPanel>
                                </Button>
                                <Button x:ConnectionId='58'
                                    helpers:Motion.HoverLift="True"
                                                         
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTipService.ToolTip="Weiterleiten (Strg+L)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="forward" />
                                        <TextBlock Text="Weiterleiten" />
                                    </StackPanel>
                                </Button>
                                <Button x:ConnectionId='59'
                                    x:Name="EditDraftButton"
                                    helpers:Motion.HoverLift="True"
                                                           
                                    Style="{StaticResource GhostButtonStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="edit" />
                                        <TextBlock Text="Entwurf bearbeiten" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button x:ConnectionId='48'
                                    x:Name="ToggleReadButton"
                                    helpers:Motion.HoverLift="True"
                                                            
                                    Style="{StaticResource IconButtonStyle}">
                                    <ImageIcon x:ConnectionId='55' x:Name="ToggleReadIcon" helpers:Svg.Kind="mail" />
                                </Button>
                                <Button x:ConnectionId='49'
                                    x:Name="FlagButton"
                                    helpers:Motion.HoverLift="True"
                                                      
                                    Style="{StaticResource IconButtonStyle}">
                                    <Grid>
                                        <ImageIcon helpers:Svg.Kind="flag" helpers:Svg.Tone="Secondary" />
                                        <Ellipse x:ConnectionId='54'
                                            x:Name="FlagDot"
                                            Width="6"
                                            Height="6"
                                            Margin="0,-3,-4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Fill="{StaticResource AccentBrush}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Button x:ConnectionId='50'
                                    x:Name="ArchiveButton"
                                    helpers:Motion.HoverLift="True"
                                                         
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Archivieren">
                                    <ImageIcon helpers:Svg.Kind="archive" />
                                </Button>
                                <Button x:ConnectionId='51'
                                    x:Name="SpamButton"
                                    helpers:Motion.HoverLift="True"
                                                      
                                    Style="{StaticResource IconButtonStyle}">
                                    <ImageIcon x:ConnectionId='53' x:Name="SpamIcon" helpers:Svg.Kind="spam" />
                                </Button>
                                <Button x:ConnectionId='52'
                                    helpers:Motion.HoverLift="True"
                                                        
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Löschen (Entf)">
                                    <ImageIcon helpers:Svg.Kind="trash" helpers:Svg.Tone="Danger" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Header  -->
                        <StackPanel x:ConnectionId='26'
                            x:Name="ReaderHeader"
                            Grid.Row="1"
                            Padding="32,14,32,18"
                            Spacing="{StaticResource SpaceLg}">
                            <TextBlock x:ConnectionId='37'
                                x:Name="DetailSubject"
                                FontSize="{StaticResource FontSizeXl}"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Top"
                                    CornerRadius="22"
                                    Style="{StaticResource AvatarStyle}">
                                    <TextBlock x:ConnectionId='47'
                                        x:Name="DetailInitials"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeBase}"
                                        FontWeight="SemiBold" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run x:ConnectionId='45'
                                            x:Name="DetailFromName"
                                            FontSize="{StaticResource FontSizeBase}"
                                            FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run x:ConnectionId='46'
                                            x:Name="DetailFromAddress"
                                            FontSize="{StaticResource FontSizeMd}"
                                            Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <ScrollViewer x:ConnectionId='39'
                                        x:Name="RecipientsScroller"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:ConnectionId='43'
                                                x:Name="DetailTo"
                                                FontSize="{StaticResource FontSizeSm}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='44'
                                                x:Name="DetailCc"
                                                FontSize="{StaticResource FontSizeSm}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <HyperlinkButton x:ConnectionId='40'
                                        x:Name="RecipientsToggle"
                                        Margin="-8,0,0,0"
                                        Padding="8,2"
                                                                      
                                        FontSize="{StaticResource FontSizeSm}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:ConnectionId='41' x:Name="RecipientsToggleText" Text="Alle Empfänger anzeigen" />
                                            <ImageIcon x:ConnectionId='42'
                                                x:Name="RecipientsToggleIcon"
                                                Width="12"
                                                Height="12"
                                                helpers:Svg.Kind="chevron-down" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                                <TextBlock x:ConnectionId='38'
                                    x:Name="DetailDate"
                                    Grid.Column="2"
                                    MaxWidth="200"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource FontSizeSm}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <!--  Attachments  -->
                        <ScrollViewer x:ConnectionId='27'
                            x:Name="AttachmentsScroller"
                            Grid.Row="2"
                            Padding="32,0,32,16"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="Collapsed">
                            <ItemsRepeater x:ConnectionId='31' x:Name="AttachmentsRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate                                   >
                                        <Button x:ConnectionId='33'
                                            Padding="8"
                                            helpers:Motion.HoverLift="True"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                                                    
                                            CornerRadius="{StaticResource RadiusMd}"
                                                          
                                                                                      >
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="36"
                                                    Height="36"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="{StaticResource RadiusSm}">
                                                    <TextBlock x:ConnectionId='36'
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource OnAccentBrush}"
                                                                                  />
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    MaxWidth="200"
                                                    VerticalAlignment="Center">
                                                    <TextBlock x:ConnectionId='34'
                                                        FontSize="{StaticResource FontSizeMd}"
                                                                                
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:ConnectionId='35'
                                                        FontSize="{StaticResource FontSizeXs}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                                                    />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!--  Body  -->
                        <Border x:ConnectionId='28'
                            x:Name="BodyCard"
                            Grid.Row="3"
                            Margin="20,0,20,20"
                            Style="{StaticResource PanelStyle}">
                            <Grid>
                                <WebView2 x:ConnectionId='29' x:Name="MailWebView" Margin="2" />
                                <ProgressRing x:ConnectionId='30'
                                    x:Name="BodyLoadingRing"
                                    Width="32"
                                    Height="32"
                                    IsActive="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Settings  -->
            <Grid x:ConnectionId='20' x:Name="SettingsHost" Visibility="Collapsed">
                <views:SettingsView x:ConnectionId='21' x:Name="SettingsPanel" />
            </Grid>
        </Grid>

        <!--  ════════════════ COMPOSE MODAL ════════════════  -->
        <Grid x:ConnectionId='12'
            x:Name="ComposeLayer"
            Grid.ColumnSpan="2"
            Visibility="Collapsed">
            <Rectangle x:ConnectionId='17' x:Name="ComposeSmoke" Fill="{StaticResource OverlayBrush}" />
            <views:ComposePanel x:ConnectionId='18'
                x:Name="Composer"
                MaxWidth="860"
                MaxHeight="820"
                Margin="40,24" />
        </Grid>

        <!--  ════════════════ TOAST ════════════════  -->
        <Border x:ConnectionId='13'
            x:Name="Toast"
            Grid.ColumnSpan="2"
            MinWidth="280"
            MaxWidth="440"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource ToastBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="{StaticResource BorderHairline}"
            CornerRadius="{StaticResource RadiusLg}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Grid>
                <StackPanel
                    Padding="16,13,18,15"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceMd}">
                    <ImageIcon x:ConnectionId='15' x:Name="ToastIcon" helpers:Svg.Kind="success" />
                    <TextBlock x:ConnectionId='16'
                        x:Name="ToastText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Rectangle x:ConnectionId='14'
                    x:Name="ToastProgress"
                    Height="2"
                    Margin="14,0,14,4"
                    VerticalAlignment="Bottom"
                    Fill="{StaticResource BorderStrongBrush}"
                    RadiusX="1"
                    RadiusY="1" />
            </Grid>
        </Border>
    </Grid>
</Page>

