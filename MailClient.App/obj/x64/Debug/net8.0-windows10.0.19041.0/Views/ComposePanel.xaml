<UserControl
    x:Class="MailClient.App.Views.ComposePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MailClient.Core.Models"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.Resources>
        <!--  Borderless "mail field" look for text boxes  -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FieldRowStyle" TargetType="Grid">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator x:ConnectionId='2' Key="Enter"                      Modifiers="Control" />
        <KeyboardAccelerator x:ConnectionId='3' Key="Escape"                       />
    </UserControl.KeyboardAccelerators>

    <Grid x:ConnectionId='4'
        x:Name="Card"
        AllowDrop="True"
        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="16"
                                  
                                
                        >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Padding="24,18,14,10">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border x:ConnectionId='32'
                    x:Name="HeaderBadge"
                    Width="38"
                    Height="38"
                    Background="{StaticResource BrandGradientBrush}"
                    CornerRadius="12">
                    <FontIcon x:ConnectionId='34'
                        x:Name="HeaderGlyph"
                        FontSize="16"
                        Foreground="White"
                        Glyph="&#xE70F;" />
                </Border>
                <TextBlock x:ConnectionId='33'
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Neue Nachricht" />
            </StackPanel>
            <Button x:ConnectionId='31'
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                                   
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Schließen (Esc)">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!--  Address fields  -->
        <StackPanel Grid.Row="1" Padding="24,0">
            <Grid Style="{StaticResource FieldRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Von" />
                <ComboBox x:ConnectionId='29'
                    x:Name="FromCombo"
                    Grid.Column="1"
                    MinWidth="260"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="Transparent" />
                <TextBlock x:ConnectionId='30'
                    x:Name="FromText"
                    Grid.Column="1"
                    Margin="11,0,0,0"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Style="{StaticResource FieldRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="An" />
                <TextBox x:ConnectionId='27'
                    x:Name="ToBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    InputScope="EmailSmtpAddress"
                    PlaceholderText="empfaenger@example.com; weitere@example.com" />
                <HyperlinkButton x:ConnectionId='28'
                    x:Name="CcToggle"
                    Grid.Column="2"
                    Padding="8,4"
                    VerticalAlignment="Center"
                                          
                    Content="CC / BCC"
                    FontSize="12" />
            </Grid>

            <Grid x:ConnectionId='22'
                x:Name="CcRow"
                Style="{StaticResource FieldRowStyle}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CC" />
                <TextBox x:ConnectionId='26'
                    x:Name="CcBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    InputScope="EmailSmtpAddress" />
            </Grid>

            <Grid x:ConnectionId='23'
                x:Name="BccRow"
                Style="{StaticResource FieldRowStyle}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="BCC" />
                <TextBox x:ConnectionId='25'
                    x:Name="BccBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    InputScope="EmailSmtpAddress" />
            </Grid>

            <Grid Style="{StaticResource FieldRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Betreff" />
                <TextBox x:ConnectionId='24'
                    x:Name="SubjectBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    PlaceholderText="Worum geht es?" />
            </Grid>
        </StackPanel>

        <!--  Body  -->
        <TextBox x:ConnectionId='5'
            x:Name="BodyBox"
            Grid.Row="2"
            Padding="24,14"
            AcceptsReturn="True"
            FontSize="14"
            IsSpellCheckEnabled="True"
            PlaceholderText="Schreibe deine Nachricht …"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap" />

        <!--  Attachments  -->
        <ScrollViewer x:ConnectionId='6'
            x:Name="AttachmentsScroller"
            Grid.Row="3"
            Padding="24,0,24,10"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            Visibility="Collapsed">
            <ItemsRepeater x:ConnectionId='15' x:Name="AttachmentsRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                   >
                        <Grid x:ConnectionId='17'
                            Padding="6,6,4,6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="8"
                            CornerRadius="10"
                                                                      >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="30"
                                Height="30"
                                Background="{StaticResource BrandGradientBrush}"
                                CornerRadius="7">
                                <TextBlock x:ConnectionId='21'
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="White"
                                                              />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                MaxWidth="180"
                                VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='19'
                                    FontSize="12"
                                                            
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock x:ConnectionId='20'
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                />
                            </StackPanel>
                            <Button x:ConnectionId='18'
                                Grid.Column="2"
                                                              
                                Style="{StaticResource SmallIconButtonStyle}"
                                              
                                ToolTipService.ToolTip="Entfernen">
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <InfoBar x:ConnectionId='7'
            x:Name="ErrorBar"
            Grid.Row="4"
            Margin="20,0,20,8"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!--  Footer  -->
        <Grid
            Grid.Row="5"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:ConnectionId='10'
                    x:Name="SendButton"
                    MinWidth="132"
                    Height="40"
                                      
                    Style="{StaticResource GradientButtonStyle}"
                    ToolTipService.ToolTip="Senden (Strg+Enter)">
                    <Grid>
                        <StackPanel x:ConnectionId='13'
                            x:Name="SendContent"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE724;" />
                            <TextBlock Text="Senden" />
                        </StackPanel>
                        <ProgressRing x:ConnectionId='14'
                            x:Name="SendRing"
                            Width="20"
                            Height="20"
                            Foreground="White"
                            IsActive="False" />
                    </Grid>
                </Button>
                <Button x:ConnectionId='11'
                    Margin="6,0,0,0"
                                        
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Dateien anhängen (oder hierher ziehen)">
                    <FontIcon FontSize="15" Glyph="&#xE723;" />
                </Button>
                <Button x:ConnectionId='12'
                    x:Name="DraftButton"
                                           
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Als Entwurf speichern">
                    <FontIcon FontSize="15" Glyph="&#xE74E;" />
                </Button>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Strg+Enter zum Senden" />
                <Button x:ConnectionId='9'
                                       
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Verwerfen">
                    <FontIcon
                        FontSize="15"
                        Foreground="{StaticResource DangerBrush}"
                        Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Drop hint  -->
        <Border x:ConnectionId='8'
            x:Name="DropHint"
            Grid.RowSpan="6"
            Margin="8"
            Background="{StaticResource BrandGradientSoftBrush}"
            BorderBrush="{StaticResource BrandBrush}"
            BorderThickness="2"
            CornerRadius="12"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource BrandTextBrush}"
                    Glyph="&#xE723;" />
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource BrandTextBrush}"
                    Text="Zum Anhängen loslassen" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

