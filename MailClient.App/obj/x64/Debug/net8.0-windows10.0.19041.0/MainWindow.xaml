<Window
    x:Class="MailClient.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MailClient.App.Views"
    Title="Mail">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:ConnectionId='2' x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:ConnectionId='3'
            x:Name="AppTitleBar"
            Title="Mail"
            Height="52"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
                                                                 >
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <AutoSuggestBox x:ConnectionId='5'
                    x:Name="SearchBox"
                    MinWidth="280"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    PlaceholderText="E-Mails durchsuchen (Enter = auf dem Server)"
                    QueryIcon="Find"
                                                             
                                                        />
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <Button x:ConnectionId='6'
                    x:Name="SyncButton"
                    Margin="0,0,8,0"
                                            
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Synchronisieren (F5)">
                    <FontIcon x:ConnectionId='7' x:Name="SyncIcon" FontSize="15" Glyph="&#xE72C;" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <views:MainPage x:ConnectionId='4' x:Name="ShellPage" Grid.Row="1" />
    </Grid>
</Window>

