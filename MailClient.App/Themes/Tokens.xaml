<!--
    Design tokens – the single source for colors, radii, spacing, type and motion.
    (WinUI counterpart of tokens.css; code reads motion values via Helpers/Tokens.cs.)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ── Colors (monochrome) ──  -->
    <Color x:Key="BgColor">#E6080808</Color>
    <Color x:Key="PanelColor">#0AFFFFFF</Color>
    <Color x:Key="PanelStrongColor">#12FFFFFF</Color>
    <Color x:Key="PanelHoverColor">#0FFFFFFF</Color>
    <Color x:Key="BorderColor">#14FFFFFF</Color>
    <Color x:Key="BorderStrongColor">#29FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F5</Color>
    <Color x:Key="TextSecondaryColor">#A3A3A3</Color>
    <Color x:Key="TextTertiaryColor">#6E6E6E</Color>
    <Color x:Key="AccentColor">#FFFFFF</Color>
    <Color x:Key="OnAccentColor">#0A0A0A</Color>
    <Color x:Key="AccentSoftColor">#1FFFFFFF</Color>
    <Color x:Key="GlowColor">#40FFFFFF</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="SkeletonColor">#12FFFFFF</Color>
    <Color x:Key="ShimmerColor">#14FFFFFF</Color>
    <Color x:Key="OverlayColor">#99000000</Color>
    <Color x:Key="ModalTintColor">#121212</Color>
    <Color x:Key="ToastColor">#F21A1A1A</Color>
    <Color x:Key="AvatarColor">#262626</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelStrongBrush" Color="{StaticResource PanelStrongColor}" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="GlowBrush" Color="{StaticResource GlowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="ToastBrush" Color="{StaticResource ToastColor}" />
    <SolidColorBrush x:Key="AvatarBrush" Color="{StaticResource AvatarColor}" />

    <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="Transparent" />
        <GradientStop Offset="0.5" Color="{StaticResource ShimmerColor}" />
        <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>

    <!--  Glass: blur only on few, large surfaces (window backdrop, modals)  -->
    <AcrylicBrush
        x:Key="GlassModalBrush"
        FallbackColor="#161616"
        TintColor="{StaticResource ModalTintColor}"
        TintLuminosityOpacity="0.85"
        TintOpacity="0.7" />

    <!--  ── Radii ──  -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">18</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusLayer">16,0,0,0</CornerRadius>

    <!--  ── Spacing ──  -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="Space2Xl">32</x:Double>
    <Thickness x:Key="PadSm">8</Thickness>
    <Thickness x:Key="PadMd">12</Thickness>
    <Thickness x:Key="PadLg">16</Thickness>
    <Thickness x:Key="PadXl">24</Thickness>
    <Thickness x:Key="PadPanel">28,24,28,24</Thickness>
    <Thickness x:Key="PadButton">16,10,16,10</Thickness>
    <Thickness x:Key="PadListItem">12,12,14,12</Thickness>
    <Thickness x:Key="BorderHairline">1</Thickness>

    <!--  ── Type (Inter, bundled locally; falls back to Segoe UI) ──  -->
    <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <x:Double x:Key="FontSizeXs">11</x:Double>
    <x:Double x:Key="FontSizeSm">12</x:Double>
    <x:Double x:Key="FontSizeMd">13</x:Double>
    <x:Double x:Key="FontSizeBase">14</x:Double>
    <x:Double x:Key="FontSizeLg">17</x:Double>
    <x:Double x:Key="FontSizeXl">22</x:Double>
    <x:Double x:Key="FontSize2Xl">28</x:Double>

    <!--  ── Motion (milliseconds; easing = cubic-bezier(0.22, 1, 0.36, 1)) ──  -->
    <x:Double x:Key="MotionFast">150</x:Double>
    <x:Double x:Key="MotionBase">220</x:Double>
    <x:Double x:Key="MotionSlow">300</x:Double>
    <x:Double x:Key="MotionStaggerStep">50</x:Double>
    <x:Double x:Key="MotionStaggerMax">10</x:Double>
    <x:Double x:Key="MotionShimmer">1400</x:Double>
    <x:Double x:Key="MotionSpin">900</x:Double>
    <x:Double x:Key="MotionToast">3500</x:Double>
    <x:Double x:Key="MotionToastError">6000</x:Double>
    <x:Double x:Key="MotionHoverLift">-2</x:Double>
    <x:Double x:Key="MotionPressScale">0.97</x:Double>
    <x:Double x:Key="MotionModalScale">0.95</x:Double>
    <x:Double x:Key="MotionModalSlide">12</x:Double>
    <x:Double x:Key="MotionEaseX1">0.22</x:Double>
    <x:Double x:Key="MotionEaseY1">1</x:Double>
    <x:Double x:Key="MotionEaseX2">0.36</x:Double>
    <x:Double x:Key="MotionEaseY2">1</x:Double>

    <!--  Accent states (mapped onto the system accent in App.xaml)  -->
    <Color x:Key="AccentHoverColor">#E8E8E8</Color>
    <Color x:Key="AccentPressedColor">#D0D0D0</Color>

    <x:Double x:Key="DialogMaxWidth">920</x:Double>
    <x:Double x:Key="DialogMaxHeight">900</x:Double>
</ResourceDictionary>
