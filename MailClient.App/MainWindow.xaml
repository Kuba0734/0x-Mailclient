<Window
    x:Class="MailClient.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    xmlns:views="using:MailClient.App.Views"
    Title="Mail">

    <!--  Glass: the window backdrop is the one big blurred surface  -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource BgBrush}"
        RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Mail"
            Height="52"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="280"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusMd}"
                    FontFamily="{StaticResource AppFont}"
                    PlaceholderText="E-Mails durchsuchen (Enter = auf dem Server)"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.QueryIcon>
                        <ImageIcon helpers:Svg.Kind="search" helpers:Svg.Tone="Secondary" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <Button
                    x:Name="SyncButton"
                    Margin="0,0,8,0"
                    helpers:Motion.HoverLift="True"
                    Click="SyncButton_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Synchronisieren (F5)">
                    <ImageIcon x:Name="SyncIcon" helpers:Svg.Kind="refresh" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <views:MainPage x:Name="ShellPage" Grid.Row="1" />
    </Grid>
</Window>
