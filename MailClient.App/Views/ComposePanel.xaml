<UserControl
    x:Class="MailClient.App.Views.ComposePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    xmlns:models="using:MailClient.Core.Models"
    FontFamily="{StaticResource AppFont}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.Resources>
        <!--  Borderless "mail field" look for text boxes  -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        </Style>
        <Style x:Key="FieldRowStyle" TargetType="Grid">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="Accel_Send" Modifiers="Control" />
        <KeyboardAccelerator Key="Escape" Invoked="Accel_Close" />
    </UserControl.KeyboardAccelerators>

    <!--  Glass modal: one large blurred surface  -->
    <Grid
        x:Name="Card"
        AllowDrop="True"
        Background="{StaticResource GlassModalBrush}"
        BorderBrush="{StaticResource BorderStrongBrush}"
        BorderThickness="{StaticResource BorderHairline}"
        CornerRadius="{StaticResource RadiusXl}"
        DragLeave="Card_DragLeave"
        DragOver="Card_DragOver"
        Drop="Card_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Padding="28,22,16,10">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                <Border
                    Width="36"
                    Height="36"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="{StaticResource RadiusMd}">
                    <ImageIcon
                        x:Name="HeaderIcon"
                        helpers:Svg.Kind="compose"
                        helpers:Svg.Tone="OnAccent" />
                </Border>
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeXl}"
                    FontWeight="SemiBold"
                    Text="Neue Nachricht" />
            </StackPanel>
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                helpers:Motion.HoverLift="True"
                Click="Close_Click"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Schließen (Esc)">
                <ImageIcon helpers:Svg.Kind="close" helpers:Svg.Tone="Secondary" />
            </Button>
        </Grid>

        <!--  Address fields  -->
        <StackPanel Grid.Row="1" Padding="28,0">
            <Grid Style="{StaticResource FieldRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Von" />
                <ComboBox
                    x:Name="FromCombo"
                    Grid.Column="1"
                    MinWidth="260"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0" />
                <TextBlock
                    x:Name="FromText"
                    Grid.Column="1"
                    Margin="11,0,0,0"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Style="{StaticResource FieldRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="An" />
                <TextBox
                    x:Name="ToBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    InputScope="EmailSmtpAddress"
                    PlaceholderText="empfaenger@example.com; weitere@example.com" />
                <HyperlinkButton
                    x:Name="CcToggle"
                    Grid.Column="2"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Click="CcToggle_Click"
                    Content="CC / BCC"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>

            <Grid
                x:Name="CcRow"
                Style="{StaticResource FieldRowStyle}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CC" />
                <TextBox
                    x:Name="CcBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    InputScope="EmailSmtpAddress" />
            </Grid>

            <Grid
                x:Name="BccRow"
                Style="{StaticResource FieldRowStyle}"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="BCC" />
                <TextBox
                    x:Name="BccBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    InputScope="EmailSmtpAddress" />
            </Grid>

            <Grid Style="{StaticResource FieldRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Betreff" />
                <TextBox
                    x:Name="SubjectBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    PlaceholderText="Worum geht es?" />
            </Grid>
        </StackPanel>

        <!--  Body  -->
        <TextBox
            x:Name="BodyBox"
            Grid.Row="2"
            Padding="28,16"
            AcceptsReturn="True"
            FontSize="{StaticResource FontSizeBase}"
            IsSpellCheckEnabled="True"
            PlaceholderText="Schreibe deine Nachricht …"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap" />

        <!--  Attachments  -->
        <ScrollViewer
            x:Name="AttachmentsScroller"
            Grid.Row="3"
            Padding="28,0,28,12"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            Visibility="Collapsed">
            <ItemsRepeater x:Name="AttachmentsRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MailAttachment">
                        <Grid
                            Padding="6,6,4,6"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="{StaticResource BorderHairline}"
                            ColumnSpacing="{StaticResource SpaceSm}"
                            CornerRadius="{StaticResource RadiusMd}"
                            ToolTipService.ToolTip="{x:Bind FileName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="30"
                                Height="30"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="{StaticResource RadiusSm}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource OnAccentBrush}"
                                    Text="{x:Bind Extension}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                MaxWidth="180"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeSm}"
                                    Text="{x:Bind FileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="{StaticResource FontSizeXs}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{x:Bind SizeDisplay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Click="RemoveAttachment_Click"
                                Style="{StaticResource SmallIconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Entfernen">
                                <ImageIcon
                                    Width="12"
                                    Height="12"
                                    helpers:Svg.Kind="close"
                                    helpers:Svg.Tone="Secondary" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="4"
            Margin="24,0,24,8"
            CornerRadius="{StaticResource RadiusMd}"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!--  Footer  -->
        <Grid
            Grid.Row="5"
            Padding="24,14"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    x:Name="SendButton"
                    MinWidth="128"
                    Height="40"
                    helpers:Motion.HoverLift="True"
                    Click="Send_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTipService.ToolTip="Senden (Strg+Enter)">
                    <Grid>
                        <StackPanel
                            x:Name="SendContent"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpaceSm}">
                            <ImageIcon helpers:Svg.Kind="send" helpers:Svg.Tone="OnAccent" />
                            <TextBlock Text="Senden" />
                        </StackPanel>
                        <ProgressRing
                            x:Name="SendRing"
                            Width="20"
                            Height="20"
                            Foreground="{StaticResource OnAccentBrush}"
                            IsActive="False" />
                    </Grid>
                </Button>
                <Button
                    Margin="6,0,0,0"
                    helpers:Motion.HoverLift="True"
                    Click="Attach_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Dateien anhängen (oder hierher ziehen)">
                    <ImageIcon helpers:Svg.Kind="paperclip" />
                </Button>
                <Button
                    x:Name="DraftButton"
                    helpers:Motion.HoverLift="True"
                    Click="SaveDraft_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Als Entwurf speichern">
                    <ImageIcon helpers:Svg.Kind="save" />
                </Button>
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceMd}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeSm}"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="Strg+Enter zum Senden" />
                <Button
                    helpers:Motion.HoverLift="True"
                    Click="Close_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Verwerfen">
                    <ImageIcon helpers:Svg.Kind="trash" helpers:Svg.Tone="Danger" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Drop hint  -->
        <Border
            x:Name="DropHint"
            Grid.RowSpan="6"
            Margin="8"
            Background="{StaticResource AccentSoftBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1.5"
            CornerRadius="{StaticResource RadiusLg}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource SpaceSm}">
                <ImageIcon
                    Width="32"
                    Height="32"
                    helpers:Svg.Kind="paperclip" />
                <TextBlock FontWeight="SemiBold" Text="Zum Anhängen loslassen" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
