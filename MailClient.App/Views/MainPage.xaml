<Page
    x:Class="MailClient.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    xmlns:models="using:MailClient.Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:MailClient.App.Views"
    Background="Transparent"
    FontFamily="{StaticResource AppFont}"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Invoked="Accel_Compose" Modifiers="Control" />
        <KeyboardAccelerator Key="F5" Invoked="Accel_Sync" />
        <KeyboardAccelerator Key="R" Invoked="Accel_Reply" Modifiers="Control" />
        <KeyboardAccelerator Key="R" Invoked="Accel_ReplyAll" Modifiers="Control,Shift" />
        <KeyboardAccelerator Key="L" Invoked="Accel_Forward" Modifiers="Control" />
        <KeyboardAccelerator Key="Q" Invoked="Accel_ToggleRead" Modifiers="Control" />
        <KeyboardAccelerator Key="E" Invoked="Accel_Search" Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ════════════════ SIDEBAR ════════════════  -->
        <Grid
            x:Name="Sidebar"
            Width="260"
            Padding="16,4,16,16"
            RowSpacing="{StaticResource SpaceMd}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                x:Name="ComposeButton"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="14,0"
                helpers:Motion.HoverLift="True"
                Click="Compose_Click"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTipService.ToolTip="Neue E-Mail (Strg+N)">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                    <ImageIcon helpers:Svg.Kind="compose" helpers:Svg.Tone="OnAccent" />
                    <TextBlock
                        x:Name="ComposeLabel"
                        VerticalAlignment="Center"
                        Text="Neue E-Mail" />
                </StackPanel>
            </Button>

            <ListView
                x:Name="FolderList"
                Grid.Row="1"
                Margin="-8,8,-8,0"
                IsItemClickEnabled="True"
                ItemClick="FolderList_ItemClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="helpers:FolderItem">
                        <Grid
                            Height="38"
                            ColumnSpacing="{StaticResource SpaceLg}"
                            Opacity="{x:Bind ItemOpacity, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ImageIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                helpers:Svg.Kind="{x:Bind Icon}"
                                helpers:Svg.Tone="Secondary" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="0,6,-4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource AccentBrush}"
                                Visibility="{x:Bind DotVisibility, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeBase}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                            <Border
                                Grid.Column="2"
                                MinWidth="22"
                                Padding="7,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="{StaticResource RadiusPill}"
                                Visibility="{x:Bind PillVisibility, Mode=OneWay}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeXs}"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind CountText, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Account switcher  -->
            <Button
                x:Name="AccountButton"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="6"
                Style="{StaticResource GhostButtonStyle}">
                <Grid ColumnSpacing="{StaticResource SpaceMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="AccountAvatar"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Style="{StaticResource AvatarStyle}">
                        <TextBlock
                            x:Name="AccountInitials"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeSm}"
                            FontWeight="SemiBold"
                            Text="+" />
                    </Border>
                    <StackPanel
                        x:Name="AccountTextPanel"
                        Grid.Column="1"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AccountNameText"
                            FontSize="{StaticResource FontSizeMd}"
                            FontWeight="SemiBold"
                            Text="Kein Konto"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="AccountMailText"
                            FontSize="{StaticResource FontSizeXs}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Konto hinzufügen"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ImageIcon
                        x:Name="AccountChevron"
                        Grid.Column="2"
                        Width="12"
                        Height="12"
                        helpers:Svg.Kind="chevron-up"
                        helpers:Svg.Tone="Secondary" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="AccountMenu" Placement="TopEdgeAlignedLeft" />
                </Button.Flyout>
            </Button>

            <Button
                x:Name="SettingsButton"
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="12,9"
                Click="Settings_Click"
                Style="{StaticResource GhostButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceLg}">
                    <ImageIcon
                        x:Name="SettingsIcon"
                        Width="18"
                        Height="18"
                        helpers:Svg.Kind="settings"
                        helpers:Svg.Tone="Secondary" />
                    <TextBlock x:Name="SettingsLabel" Text="Einstellungen" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  ════════════════ CONTENT LAYER (glass panel) ════════════════  -->
        <Grid
            x:Name="ContentLayer"
            Grid.Column="1"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="{StaticResource RadiusLayer}">

            <Grid x:Name="MailArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ── Message list ──  -->
                <Grid
                    x:Name="ListColumn"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="24,22,14,4">
                        <StackPanel x:Name="FolderHeader">
                            <TextBlock
                                x:Name="FolderTitle"
                                FontSize="{StaticResource FontSize2Xl}"
                                FontWeight="SemiBold"
                                Text="Posteingang"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="FolderSubtitle"
                                Margin="0,4,0,0"
                                FontSize="{StaticResource FontSizeSm}"
                                Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            helpers:Motion.HoverLift="True"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Weitere Aktionen">
                            <ImageIcon helpers:Svg.Kind="more" helpers:Svg.Tone="Secondary" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Click="MarkAllRead_Click" Text="Alle als gelesen markieren">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon helpers:Svg.Kind="mail-open" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="Reload_Click" Text="Ordner neu laden">
                                        <MenuFlyoutItem.Icon>
                                            <ImageIcon helpers:Svg.Kind="refresh" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <toolkit:Segmented
                        x:Name="FilterSegmented"
                        Grid.Row="1"
                        Margin="20,12,20,12"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="Filter_SelectionChanged">
                        <toolkit:SegmentedItem Content="Alle" />
                        <toolkit:SegmentedItem Content="Ungelesen" />
                        <toolkit:SegmentedItem Content="Markiert" />
                    </toolkit:Segmented>

                    <InfoBar
                        x:Name="MailInfoBar"
                        Grid.Row="2"
                        Margin="16,0,16,8"
                        CornerRadius="{StaticResource RadiusMd}"
                        IsClosable="True"
                        IsOpen="False" />

                    <Grid Grid.Row="3">
                        <!--  Skeleton + shimmer  -->
                        <Grid
                            x:Name="SkeletonHost"
                            IsHitTestVisible="False"
                            SizeChanged="SkeletonHost_SizeChanged"
                            Visibility="Collapsed">
                            <ItemsControl x:Name="SkeletonList" Padding="16,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="{StaticResource PadListItem}" ColumnSpacing="{StaticResource SpaceMd}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Width="38"
                                                Height="38"
                                                VerticalAlignment="Top"
                                                Fill="{StaticResource SkeletonBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="9">
                                                <Rectangle
                                                    Width="140"
                                                    Height="11"
                                                    HorizontalAlignment="Left"
                                                    Fill="{StaticResource SkeletonBrush}"
                                                    RadiusX="5"
                                                    RadiusY="5" />
                                                <Rectangle
                                                    Height="9"
                                                    Margin="0,0,40,0"
                                                    Fill="{StaticResource SkeletonBrush}"
                                                    RadiusX="4"
                                                    RadiusY="4" />
                                                <Rectangle
                                                    Height="9"
                                                    Margin="0,0,90,0"
                                                    Fill="{StaticResource SkeletonBrush}"
                                                    RadiusX="4"
                                                    RadiusY="4" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle
                                x:Name="ShimmerBar"
                                Width="220"
                                HorizontalAlignment="Left"
                                Fill="{StaticResource ShimmerBrush}" />
                        </Grid>

                        <!--  Empty state  -->
                        <StackPanel
                            x:Name="EmptyPanel"
                            Padding="{StaticResource PadXl}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource SpaceSm}"
                            Visibility="Collapsed">
                            <Border
                                Width="72"
                                Height="72"
                                Margin="0,0,0,12"
                                CornerRadius="36"
                                Style="{StaticResource PanelStyle}">
                                <ImageIcon
                                    x:Name="EmptyIcon"
                                    Width="28"
                                    Height="28"
                                    helpers:Svg.Kind="check"
                                    helpers:Svg.Tone="Secondary" />
                            </Border>
                            <TextBlock
                                x:Name="EmptyTitle"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeLg}"
                                FontWeight="SemiBold"
                                Text="Alles erledigt" />
                            <TextBlock
                                x:Name="EmptySubtitle"
                                MaxWidth="260"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  No account  -->
                        <StackPanel
                            x:Name="NoAccountPanel"
                            Padding="{StaticResource PadXl}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource SpaceSm}"
                            Visibility="Collapsed">
                            <Border
                                Width="84"
                                Height="84"
                                Margin="0,0,0,16"
                                CornerRadius="42"
                                Style="{StaticResource PanelStyle}">
                                <ImageIcon
                                    Width="32"
                                    Height="32"
                                    helpers:Svg.Kind="mail" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeXl}"
                                FontWeight="SemiBold"
                                Text="Willkommen bei Mail" />
                            <TextBlock
                                MaxWidth="280"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Füge dein erstes E-Mail-Konto hinzu, um loszulegen."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                helpers:Motion.HoverLift="True"
                                Click="AddAccount_Click"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                    <ImageIcon helpers:Svg.Kind="plus" helpers:Svg.Tone="OnAccent" />
                                    <TextBlock Text="Konto hinzufügen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  Mail list  -->
                        <ListView
                            x:Name="MailList"
                            Padding="0,0,0,16"
                            ContainerContentChanging="MailList_ContainerContentChanging"
                            IsItemClickEnabled="False"
                            KeyDown="MailList_KeyDown"
                            SelectionChanged="MailList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.Resources>
                                <!--  Hover is drawn by the item itself (lift + glow)  -->
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="10,2" />
                                    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MailMessage">
                                    <Grid
                                        Padding="{StaticResource PadListItem}"
                                        helpers:Motion.HoverLift="True"
                                        Background="Transparent"
                                        ColumnSpacing="{StaticResource SpaceMd}"
                                        PointerEntered="MailItem_PointerEntered"
                                        PointerExited="MailItem_PointerExited">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Hover glow (no blur on list items)  -->
                                        <Border
                                            x:Name="HoverGlow"
                                            Grid.ColumnSpan="2"
                                            Margin="-12,-12,-14,-12"
                                            Background="{StaticResource PanelHoverBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="{StaticResource BorderHairline}"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Opacity="0" />

                                        <Grid
                                            Width="38"
                                            Height="38"
                                            VerticalAlignment="Top">
                                            <Border CornerRadius="19" Style="{StaticResource AvatarStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeMd}"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind helpers:Fmt.Initials(FromDisplay)}" />
                                            </Border>
                                            <Ellipse
                                                Width="11"
                                                Height="11"
                                                Margin="0,-2,-3,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Fill="{StaticResource AccentBrush}"
                                                Stroke="{StaticResource OnAccentBrush}"
                                                StrokeThickness="2"
                                                Visibility="{x:Bind helpers:Fmt.VisNot(IsRead), Mode=OneWay}" />
                                        </Grid>

                                        <StackPanel
                                            Grid.Column="1"
                                            Opacity="{x:Bind helpers:Fmt.ReadOpacity(IsRead), Mode=OneWay}"
                                            Spacing="3">
                                            <Grid ColumnSpacing="{StaticResource SpaceSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="{StaticResource FontSizeBase}"
                                                    FontWeight="{x:Bind helpers:Fmt.Weight(IsRead), Mode=OneWay}"
                                                    Text="{x:Bind FromDisplay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeXs}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{x:Bind helpers:Fmt.ListDate(Date)}" />
                                            </Grid>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="{StaticResource FontSizeMd}"
                                                    FontWeight="{x:Bind helpers:Fmt.Weight(IsRead), Mode=OneWay}"
                                                    Text="{x:Bind Subject}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <ImageIcon
                                                        Width="12"
                                                        Height="12"
                                                        helpers:Svg.Kind="paperclip"
                                                        helpers:Svg.Tone="Secondary"
                                                        Visibility="{x:Bind helpers:Fmt.Vis(HasAttachments)}" />
                                                    <ImageIcon
                                                        Width="12"
                                                        Height="12"
                                                        helpers:Svg.Kind="flag"
                                                        Visibility="{x:Bind helpers:Fmt.Vis(IsFlagged), Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                FontSize="{StaticResource FontSizeSm}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                MaxLines="2"
                                                Text="{x:Bind Preview}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!--  Hover quick actions  -->
                                        <StackPanel
                                            x:Name="HoverActions"
                                            Grid.Column="1"
                                            Margin="0,-6,-6,0"
                                            Padding="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource ToastBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="{StaticResource BorderHairline}"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            IsHitTestVisible="False"
                                            Loaded="HoverActions_Loaded"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <Button
                                                Click="HoverRead_Click"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind helpers:Fmt.ReadLabel(IsRead), Mode=OneWay}">
                                                <ImageIcon
                                                    Width="14"
                                                    Height="14"
                                                    helpers:Svg.Kind="{x:Bind helpers:Fmt.ReadIcon(IsRead), Mode=OneWay}" />
                                            </Button>
                                            <Button
                                                Click="HoverFlag_Click"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{x:Bind helpers:Fmt.FlagLabel(IsFlagged), Mode=OneWay}">
                                                <ImageIcon
                                                    Width="14"
                                                    Height="14"
                                                    helpers:Svg.Kind="flag" />
                                            </Button>
                                            <Button
                                                Click="HoverDelete_Click"
                                                Style="{StaticResource SmallIconButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Löschen">
                                                <ImageIcon
                                                    Width="14"
                                                    Height="14"
                                                    helpers:Svg.Kind="trash"
                                                    helpers:Svg.Tone="Danger" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <Grid
                                    x:Name="LoadMorePanel"
                                    Padding="16,12"
                                    Visibility="Collapsed">
                                    <Button
                                        x:Name="LoadMoreButton"
                                        HorizontalAlignment="Center"
                                        helpers:Motion.HoverLift="True"
                                        Click="LoadMore_Click"
                                        Style="{StaticResource GhostButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                            <ImageIcon
                                                Width="14"
                                                Height="14"
                                                helpers:Svg.Kind="arrow-down"
                                                helpers:Svg.Tone="Secondary" />
                                            <TextBlock Text="Ältere E-Mails laden" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressRing
                                        x:Name="LoadMoreRing"
                                        Width="22"
                                        Height="22"
                                        IsActive="False" />
                                </Grid>
                            </ListView.Footer>
                        </ListView>
                    </Grid>
                </Grid>

                <!--  ── Reader ──  -->
                <Grid x:Name="ReaderColumn" Grid.Column="1">

                    <StackPanel
                        x:Name="ReaderEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceSm}">
                        <Border
                            Width="96"
                            Height="96"
                            Margin="0,0,0,16"
                            CornerRadius="48"
                            Style="{StaticResource PanelStyle}">
                            <ImageIcon
                                Width="34"
                                Height="34"
                                helpers:Svg.Kind="mail-open"
                                helpers:Svg.Tone="Secondary" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeXl}"
                            FontWeight="SemiBold"
                            Text="Keine E-Mail ausgewählt" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Wähle links eine Nachricht aus, um sie hier zu lesen." />
                    </StackPanel>

                    <Grid x:Name="ReaderContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar  -->
                        <Grid Padding="20,12,20,4">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                                <Button
                                    helpers:Motion.HoverLift="True"
                                    Click="Reply_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTipService.ToolTip="Antworten (Strg+R)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="reply" />
                                        <TextBlock Text="Antworten" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    helpers:Motion.HoverLift="True"
                                    Click="ReplyAll_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTipService.ToolTip="Allen antworten (Strg+Umschalt+R)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="reply-all" />
                                        <TextBlock Text="Allen antworten" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    helpers:Motion.HoverLift="True"
                                    Click="Forward_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    ToolTipService.ToolTip="Weiterleiten (Strg+L)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="forward" />
                                        <TextBlock Text="Weiterleiten" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="EditDraftButton"
                                    helpers:Motion.HoverLift="True"
                                    Click="EditDraft_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                                        <ImageIcon helpers:Svg.Kind="edit" />
                                        <TextBlock Text="Entwurf bearbeiten" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    x:Name="ToggleReadButton"
                                    helpers:Motion.HoverLift="True"
                                    Click="ToggleRead_Click"
                                    Style="{StaticResource IconButtonStyle}">
                                    <ImageIcon x:Name="ToggleReadIcon" helpers:Svg.Kind="mail" />
                                </Button>
                                <Button
                                    x:Name="FlagButton"
                                    helpers:Motion.HoverLift="True"
                                    Click="Flag_Click"
                                    Style="{StaticResource IconButtonStyle}">
                                    <Grid>
                                        <ImageIcon helpers:Svg.Kind="flag" helpers:Svg.Tone="Secondary" />
                                        <Ellipse
                                            x:Name="FlagDot"
                                            Width="6"
                                            Height="6"
                                            Margin="0,-3,-4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Fill="{StaticResource AccentBrush}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="ArchiveButton"
                                    helpers:Motion.HoverLift="True"
                                    Click="Archive_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Archivieren">
                                    <ImageIcon helpers:Svg.Kind="archive" />
                                </Button>
                                <Button
                                    x:Name="SpamButton"
                                    helpers:Motion.HoverLift="True"
                                    Click="Spam_Click"
                                    Style="{StaticResource IconButtonStyle}">
                                    <ImageIcon x:Name="SpamIcon" helpers:Svg.Kind="spam" />
                                </Button>
                                <Button
                                    helpers:Motion.HoverLift="True"
                                    Click="Delete_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Löschen (Entf)">
                                    <ImageIcon helpers:Svg.Kind="trash" helpers:Svg.Tone="Danger" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Header  -->
                        <StackPanel
                            x:Name="ReaderHeader"
                            Grid.Row="1"
                            Padding="32,14,32,18"
                            Spacing="{StaticResource SpaceLg}">
                            <TextBlock
                                x:Name="DetailSubject"
                                FontSize="{StaticResource FontSizeXl}"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Top"
                                    CornerRadius="22"
                                    Style="{StaticResource AvatarStyle}">
                                    <TextBlock
                                        x:Name="DetailInitials"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeBase}"
                                        FontWeight="SemiBold" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run
                                            x:Name="DetailFromName"
                                            FontSize="{StaticResource FontSizeBase}"
                                            FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run
                                            x:Name="DetailFromAddress"
                                            FontSize="{StaticResource FontSizeMd}"
                                            Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <ScrollViewer
                                        x:Name="RecipientsScroller"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                x:Name="DetailTo"
                                                FontSize="{StaticResource FontSizeSm}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="DetailCc"
                                                FontSize="{StaticResource FontSizeSm}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <HyperlinkButton
                                        x:Name="RecipientsToggle"
                                        Margin="-8,0,0,0"
                                        Padding="8,2"
                                        Click="RecipientsToggle_Click"
                                        FontSize="{StaticResource FontSizeSm}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="RecipientsToggleText" Text="Alle Empfänger anzeigen" />
                                            <ImageIcon
                                                x:Name="RecipientsToggleIcon"
                                                Width="12"
                                                Height="12"
                                                helpers:Svg.Kind="chevron-down" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                                <TextBlock
                                    x:Name="DetailDate"
                                    Grid.Column="2"
                                    MaxWidth="200"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource FontSizeSm}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <!--  Attachments  -->
                        <ScrollViewer
                            x:Name="AttachmentsScroller"
                            Grid.Row="2"
                            Padding="32,0,32,16"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="Collapsed">
                            <ItemsRepeater x:Name="AttachmentsRepeater">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:MailAttachment">
                                        <Button
                                            Padding="8"
                                            helpers:Motion.HoverLift="True"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            Click="Attachment_Click"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind FileName}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="36"
                                                    Height="36"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="{StaticResource RadiusSm}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource OnAccentBrush}"
                                                        Text="{x:Bind Extension}" />
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    MaxWidth="200"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeMd}"
                                                        Text="{x:Bind FileName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeXs}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{x:Bind SizeDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!--  Body  -->
                        <Border
                            x:Name="BodyCard"
                            Grid.Row="3"
                            Margin="20,0,20,20"
                            Style="{StaticResource PanelStyle}">
                            <Grid>
                                <WebView2 x:Name="MailWebView" Margin="2" />
                                <ProgressRing
                                    x:Name="BodyLoadingRing"
                                    Width="32"
                                    Height="32"
                                    IsActive="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Settings  -->
            <Grid x:Name="SettingsHost" Visibility="Collapsed">
                <views:SettingsView x:Name="SettingsPanel" />
            </Grid>
        </Grid>

        <!--  ════════════════ COMPOSE MODAL ════════════════  -->
        <Grid
            x:Name="ComposeLayer"
            Grid.ColumnSpan="2"
            Visibility="Collapsed">
            <Rectangle x:Name="ComposeSmoke" Fill="{StaticResource OverlayBrush}" />
            <views:ComposePanel
                x:Name="Composer"
                MaxWidth="860"
                MaxHeight="820"
                Margin="40,24" />
        </Grid>

        <!--  ════════════════ TOAST ════════════════  -->
        <Border
            x:Name="Toast"
            Grid.ColumnSpan="2"
            MinWidth="280"
            MaxWidth="440"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource ToastBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="{StaticResource BorderHairline}"
            CornerRadius="{StaticResource RadiusLg}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Grid>
                <StackPanel
                    Padding="16,13,18,15"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceMd}">
                    <ImageIcon x:Name="ToastIcon" helpers:Svg.Kind="success" />
                    <TextBlock
                        x:Name="ToastText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Rectangle
                    x:Name="ToastProgress"
                    Height="2"
                    Margin="14,0,14,4"
                    VerticalAlignment="Bottom"
                    Fill="{StaticResource BorderStrongBrush}"
                    RadiusX="1"
                    RadiusY="1" />
            </Grid>
        </Border>
    </Grid>
</Page>
