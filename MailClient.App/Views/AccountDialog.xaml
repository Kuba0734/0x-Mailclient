<ContentDialog
    x:Class="MailClient.App.Views.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    CornerRadius="{StaticResource RadiusXl}"
    FontFamily="{StaticResource AppFont}"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click"
    PrimaryButtonText="Speichern"
    SecondaryButtonClick="Test_Click"
    SecondaryButtonText="Verbindung testen"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Border
                Width="40"
                Height="40"
                Background="{StaticResource AccentBrush}"
                CornerRadius="{StaticResource RadiusMd}">
                <ImageIcon helpers:Svg.Kind="mail" helpers:Svg.Tone="OnAccent" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Konto hinzufügen" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Serverdaten werden für bekannte Anbieter automatisch ausgefüllt" />
            </StackPanel>
        </StackPanel>
    </ContentDialog.Title>

    <ScrollViewer Width="620" Padding="0,0,16,0">
        <StackPanel Padding="0,4,0,8" Spacing="14">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="DisplayNameBox"
                    Header="Anzeigename"
                    PlaceholderText="Max Mustermann" />
                <TextBox
                    x:Name="EmailBox"
                    Grid.Column="1"
                    Header="E-Mail-Adresse *"
                    InputScope="EmailSmtpAddress"
                    PlaceholderText="name@example.com"
                    TextChanged="EmailBox_TextChanged" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="UsernameBox"
                    Header="Benutzername"
                    PlaceholderText="leer = E-Mail-Adresse" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Grid.Column="1"
                    Header="Passwort *"
                    PasswordRevealMode="Peek"
                    PlaceholderText="••••••••" />
            </Grid>

            <InfoBar
                x:Name="ProviderHint"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational" />

            <Expander
                x:Name="ServerExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Padding="0,10" Orientation="Horizontal" Spacing="12">
                        <ImageIcon helpers:Svg.Kind="server" helpers:Svg.Tone="Secondary" />
                        <StackPanel>
                            <TextBlock Text="Servereinstellungen" />
                            <TextBlock
                                x:Name="ServerSummary"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="IMAP &amp; SMTP" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>

                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Posteingang (IMAP)" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ImapHostBox"
                            Header="Server *"
                            PlaceholderText="imap.example.com" />
                        <NumberBox
                            x:Name="ImapPortBox"
                            Grid.Column="1"
                            Header="Port"
                            Maximum="65535"
                            Minimum="1"
                            Value="993" />
                        <ToggleSwitch
                            x:Name="ImapSslToggle"
                            Grid.Column="2"
                            Header="SSL/TLS"
                            IsOn="True"
                            OffContent="Aus"
                            OnContent="An"
                            Toggled="ImapSsl_Toggled" />
                    </Grid>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontWeight="SemiBold"
                        Text="Postausgang (SMTP)" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SmtpHostBox"
                            Header="Server *"
                            PlaceholderText="smtp.example.com" />
                        <NumberBox
                            x:Name="SmtpPortBox"
                            Grid.Column="1"
                            Header="Port"
                            Maximum="65535"
                            Minimum="1"
                            Value="587" />
                        <ToggleSwitch
                            x:Name="SmtpSslToggle"
                            Grid.Column="2"
                            Header="SSL/STARTTLS"
                            IsOn="True"
                            OffContent="Aus"
                            OnContent="An" />
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Port 993/465 = SSL direkt, 143/587 = STARTTLS. Die richtige Methode wird automatisch gewählt."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <TextBox
                x:Name="SignatureBox"
                MinHeight="80"
                AcceptsReturn="True"
                Header="Signatur (optional)"
                PlaceholderText="Viele Grüße&#x0a;Max Mustermann"
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="DialogInfoBar"
                IsClosable="False"
                IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
