<UserControl
    x:Class="MailClient.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    xmlns:models="using:MailClient.Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    FontFamily="{StaticResource AppFont}">

    <ScrollViewer
        x:Name="Scroller"
        Padding="40,28,40,40"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <StackPanel
            x:Name="Root"
            MaxWidth="900"
            HorizontalAlignment="Left"
            Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Grid Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="Einstellungen" />
                    <TextBlock
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Konten, Darstellung, Autostart und Synchronisierung" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Close_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Schließen">
                    <ImageIcon helpers:Svg.Kind="close" />
                </Button>
            </Grid>

            <InfoBar
                x:Name="SettingsInfoBar"
                Margin="0,8,0,0"
                IsClosable="True"
                IsOpen="False" />

            <!--  ACCOUNTS  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="E-Mail-Konten" />

            <ItemsRepeater x:Name="AccountsRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MailAccount">
                        <toolkit:SettingsCard Description="{x:Bind EmailAddress}" Header="{x:Bind Name}">
                            <toolkit:SettingsCard.HeaderIcon>
                                <ImageIcon helpers:Svg.Kind="mail" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{x:Bind ImapHost}" />
                                <Button
                                    Click="EditAccount_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Bearbeiten">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ImageIcon helpers:Svg.Kind="edit" />
                                        <TextBlock Text="Bearbeiten" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="DeleteAccount_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Konto entfernen">
                                    <ImageIcon helpers:Svg.Kind="trash" helpers:Svg.Tone="Danger" />
                                </Button>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <toolkit:SettingsCard
                Click="AddAccount_Click"
                Description="IMAP/SMTP – Gmail, Outlook, GMX, Web.de, iCloud u. v. m. werden automatisch erkannt"
                Header="Konto hinzufügen"
                IsClickEnabled="True">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="user-plus" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <!--  APPEARANCE  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Darstellung" />

            <toolkit:SettingsCard Description="Schaltet Übergänge und Bewegungen fast vollständig ab (gilt auch, wenn Animationen in Windows deaktiviert sind)" Header="Animationen reduzieren">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="motion" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="ReduceMotionToggle"
                    OffContent="Aus"
                    OnContent="An"
                    Toggled="Behavior_Toggled" />
            </toolkit:SettingsCard>

            <!--  STARTUP & TRAY  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Start &amp; Infobereich" />

            <toolkit:SettingsExpander
                Description="Mail automatisch starten, wenn du dich bei Windows anmeldest"
                Header="Mit Windows starten"
                IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="power" />
                </toolkit:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    x:Name="AutostartToggle"
                    OffContent="Aus"
                    OnContent="An"
                    Toggled="Autostart_Toggled" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Description="Beim automatischen Start nur das Symbol im Infobereich anzeigen" Header="Minimiert im Infobereich starten">
                        <ToggleSwitch
                            x:Name="StartMinimizedToggle"
                            OffContent="Aus"
                            OnContent="An"
                            Toggled="Behavior_Toggled" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsCard Description="Das X schließt das Fenster, Mail läuft im Infobereich weiter und meldet neue E-Mails" Header="Beim Schließen in den Infobereich minimieren">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="close" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="CloseToTrayToggle"
                    OffContent="Aus"
                    OnContent="An"
                    Toggled="Behavior_Toggled" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Beim Minimieren verschwindet das Fenster aus der Taskleiste" Header="Beim Minimieren in den Infobereich">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="minus" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="MinimizeToTrayToggle"
                    OffContent="Aus"
                    OnContent="An"
                    Toggled="Behavior_Toggled" />
            </toolkit:SettingsCard>

            <!--  SYNC  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Synchronisierung &amp; Benachrichtigungen" />

            <toolkit:SettingsCard Description="Wie oft im Hintergrund nach neuen E-Mails gesucht wird" Header="Automatisch abrufen">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="clock" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="SyncCombo"
                    MinWidth="180"
                    SelectionChanged="Sync_Changed">
                    <ComboBoxItem Content="Manuell" Tag="0" />
                    <ComboBoxItem Content="Jede Minute" Tag="1" />
                    <ComboBoxItem Content="Alle 2 Minuten" Tag="2" />
                    <ComboBoxItem Content="Alle 5 Minuten" Tag="5" />
                    <ComboBoxItem Content="Alle 10 Minuten" Tag="10" />
                    <ComboBoxItem Content="Alle 15 Minuten" Tag="15" />
                    <ComboBoxItem Content="Alle 30 Minuten" Tag="30" />
                </ComboBox>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Description="Windows-Benachrichtigung, wenn neue E-Mails eintreffen und Mail im Hintergrund ist" Header="Benachrichtigungen">
                <toolkit:SettingsCard.HeaderIcon>
                    <ImageIcon helpers:Svg.Kind="bell" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="NotificationsToggle"
                    OffContent="Aus"
                    OnContent="An"
                    Toggled="Behavior_Toggled" />
            </toolkit:SettingsCard>

            <!--  ABOUT  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Info" />

            <toolkit:SettingsExpander Description="Version 2.0 · IMAP/SMTP via MailKit · WinUI 3" Header="Mail">
                <toolkit:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppLogo.png" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Tastenkürzel">
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Strg+N Neu · Strg+R Antworten · Strg+Umschalt+R Allen · Strg+L Weiterleiten · Strg+Q Gelesen · Entf Löschen · F5 Abrufen · Strg+E Suchen"
                            TextAlignment="Right"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Datenordner">
                        <TextBlock
                            x:Name="DataDirText"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
