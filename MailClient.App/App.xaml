<Application
    x:Class="MailClient.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MailClient.App.Helpers"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  System brushes mapped onto the design tokens (lightweight styling)  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource PanelColor}" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource PanelColor}" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource PanelStrongColor}" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource BorderColor}" />
                    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="{StaticResource OverlayColor}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource PanelHoverColor}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource PanelStrongColor}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource PanelStrongColor}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource PanelStrongColor}" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource AccentColor}" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderStrongColor}" />
                    <StaticResource x:Key="ContentDialogBackground" ResourceKey="GlassModalBrush" />
                    <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="PanelBrush" />
                    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{StaticResource BorderColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Accent = white, text on accent = black (from tokens)  -->
            <StaticResource x:Key="SystemAccentColor" ResourceKey="AccentColor" />
            <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="AccentColor" />
            <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="AccentColor" />
            <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="AccentColor" />
            <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="AccentHoverColor" />
            <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="AccentPressedColor" />
            <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="AccentPressedColor" />
            <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="AppFont" />
            <StaticResource x:Key="ContentDialogMaxWidth" ResourceKey="DialogMaxWidth" />
            <StaticResource x:Key="ContentDialogMaxHeight" ResourceKey="DialogMaxHeight" />
            <StaticResource x:Key="OverlayCornerRadius" ResourceKey="RadiusXl" />
            <StaticResource x:Key="ControlCornerRadius" ResourceKey="RadiusSm" />

            <!--  Icons are inline SVG (helpers:Svg), default 16px  -->
            <Style TargetType="ImageIcon">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>

            <!--  Primary action: white surface, black text, glow on hover  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Padding" Value="{StaticResource PadButton}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <Border
                                    x:Name="HoverGlow"
                                    Margin="-3"
                                    BorderBrush="{StaticResource GlowBrush}"
                                    BorderThickness="3"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    Opacity="0" />
                                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Quiet button (toolbars, lists)  -->
            <Style x:Key="GhostButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="IconButtonStyle" BasedOn="{StaticResource GhostButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SmallIconButtonStyle" BasedOn="{StaticResource GhostButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
            </Style>

            <!--  Glass panel (semi-transparent, hairline border)  -->
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderHairline}" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            </Style>

            <Style x:Key="AvatarStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AvatarBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderHairline}" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="2,28,0,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
